var language := "en"


func _ready() -> void:
	language = Meta.language
	if language not in LANGUAGES:
		language = "en"
	# 截图 / 调试用：--zh 只在本次运行生效，不写存档。
	if "--zh" in OS.get_cmdline_user_args():
		language = "zh"


func t(key: String) -> String:
	var table: Dictionary = STRINGS.get(language, STRINGS["en"])
	if table.has(key):
		return str(table[key])
	return str(STRINGS["en"].get(key, key))


func gear_name(id: String) -> String:
	return t("gear_" + id)


func set_language(code: String) -> void:
	if code not in LANGUAGES or code == language:
		return
	language = code
	Meta.language = code
	Meta.save_data()
	changed.emit()
